# ==============================================================================
# .env.example — Environment variable template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  Never commit .env to version control — it contains secrets.
# ⚠️  All variables without defaults are REQUIRED to start the server.
# ==============================================================================


# ------------------------------------------------------------------------------
# Django Core
# ------------------------------------------------------------------------------

# Controls which settings file loads:
#   development → config/settings/development.py  (default if unset)
#   production  → config/settings/production.py
#   testing     → config/settings/testing.py  (set automatically by test runner)
DJANGO_ENV=development

# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required. No default. Server will not start without this.
DJANGO_SECRET_KEY=

DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------

POSTGRES_DB=authdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=               # Required. Use a strong password in production.
POSTGRES_HOST=db                 # Use "db" in Docker, "localhost" for local dev
POSTGRES_PORT=5432

# Local development without Docker — uncomment and adjust:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433             # Change if your local Postgres runs on a different port


# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------

# Required. Used by Redis --requirepass and must match the password in broker URLs below.
REDIS_PASSWORD=

# ⚠️  Broker URLs MUST include REDIS_PASSWORD or Celery will fail with NOAUTH error.
#
# In Docker:
CELERY_BROKER_URL=redis://:yourpassword@redis:6379/0
CELERY_RESULT_BACKEND=redis://:yourpassword@redis:6379/1
#
# Local development without Docker (if your local Redis has no password):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ------------------------------------------------------------------------------
# Gunicorn & Celery tuning (optional — defaults shown)
# ------------------------------------------------------------------------------

GUNICORN_WORKERS=3               # Recommended: (2 * CPU cores) + 1
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=4             # Recommended: number of CPU cores


# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------

# Use console backend in development (prints emails to terminal, no SMTP needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Switch to SMTP in production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=                 # your-email@gmail.com
EMAIL_HOST_PASSWORD=             # Gmail: use an App Password, not your account password
DEFAULT_FROM_EMAIL=noreply@example.com


# ------------------------------------------------------------------------------
# Authentication & Accounts
# ------------------------------------------------------------------------------

# "optional" lets users skip email verification (good for development)
# "mandatory" requires email verification before login (use in production)
ACCOUNT_EMAIL_VERIFICATION=optional


# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------

FRONTEND_URL=http://localhost:3000
SOCIALACCOUNT_CALLBACK_URL=http://localhost:3000/auth/callback


# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------------------------------------------
# Security (set all to True in production, keep False in development)
# ------------------------------------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0            # Set to 31536000 (1 year) in production
SECURE_HSTS_INCLUDE_SUBDOMAINS=False


# ------------------------------------------------------------------------------
# Social OAuth (leave blank if not using a provider)
# Get credentials from each provider's developer console.
# ------------------------------------------------------------------------------

# Google — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# Monitoring (optional)
# ------------------------------------------------------------------------------

# Sentry error tracking — https://sentry.io/
# Leave blank to disable.
SENTRY_DSN=