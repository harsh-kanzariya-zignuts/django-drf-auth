# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here-min-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=mydb
POSTGRES_USER=myuser    # use postgres for docker creds
POSTGRES_PASSWORD=securepassword
POSTGRES_HOST=localhost    # use db for docker creds
POSTGRES_PORT=5432
CONN_MAX_AGE=60

# Frontend
FRONTEND_URL=http://localhost:3000

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Account Settings
ACCOUNT_EMAIL_VERIFICATION=optional

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
DJANGO_LOG_LEVEL=INFO

# Sentry (optional)
SENTRY_DSN=


# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0  # Use redis://redis:6379/0 in Docker
CELERY_RESULT_BACKEND=redis://localhost:6379/1  # Use redis://redis:6379/1 in Docker